config {
  type: "view",
  schema: dataform.projectConfig.vars.mart_dataset,
  name: "v_looker_l1_l2_support",
  description: "Looker Studio / BI support triage view over fct_turns (see deploy/bigquery/ge_mart/mart/v_looker_l1_l2_support.sql).",
  dependencies: ["fct_turns"]
}

SELECT
  turn_id,
  event_timestamp,
  event_date,
  engine_key,
  session_id,
  user_email,
  agent_name,
  agent_id,
  model_name,
  turn_kind,
  turn_status,
  is_failed,
  is_actionable_issue,
  is_guardrail_blocked,
  llm_calls,
  input_tokens,
  output_tokens,
  cached_input_tokens,
  total_tokens,
  tool_call_count,
  tool_failure_count
FROM ${ref("fct_turns")}
