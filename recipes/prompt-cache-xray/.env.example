# Copy this file to .env (app/__init__.py loads it with python-dotenv).
# Every variable the recipe reads is declared here; empty means "unset".

# --- Model -------------------------------------------------------------------
# Model the agent calls. Models with a rate card in app/pricing.py get dollar
# figures; any other model is reported as unpriced (never guessed).
MODEL_NAME=gemini-3.8-flash

# --- Google Cloud / Vertex AI (Application Default Credentials) --------------
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# To use a Gemini API key instead, set GOOGLE_GENAI_USE_VERTEXAI=False and
# GOOGLE_API_KEY=your-api-key

# --- Recipe behaviour ----------------------------------------------------------
# true prepends "Current time: ..." and "Request id: ..." to the system
# instruction on every request -- the anti-pattern this recipe detects. Run
# "x-ray my session" with it on, then off, to see PREFIX_BUSTED vs APPEND_ONLY.
DEMO_CACHE_BUSTER=false

# Optional JSON object that adds or overrides rate cards (USD per 1M tokens):
# {"gemini-x": {"input": 0.30, "cached_read": 0.03, "cache_write": 0.30, "output": 2.50}}
RATE_CARDS_JSON=

# --- Serving (app/fast_api_app.py and app/app_utils) -------------------------
# Version string advertised in the A2A agent card (the Dockerfile sets it too).
AGENT_VERSION=0.1.0
# Comma-separated CORS allowlist for the API server. Empty = default policy.
ALLOW_ORIGINS=
# Public URL advertised in the A2A agent card. Empty = request host.
APP_URL=
# Session storage: empty = in-memory. Otherwise an ADK session URI
# (e.g. sqlite:///sessions.db, agentengine://...).
SESSION_SERVICE_URI=
# Agent Engine managed sessions (used only when SESSION_SERVICE_URI is empty).
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=
# GCS bucket for ADK artifacts. Empty = in-memory artifacts.
LOGS_BUCKET_NAME=
