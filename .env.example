# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
PORT=8080
HOST=0.0.0.0
USE_UVICORN=1

# ADK model backend. Without a Gemini API key the agent uses Vertex AI with your credentials
# (these are also the defaults app/agent.py applies). The caller needs aiplatform.endpoints.predict.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini Enterprise Agent Fleet & Telemetry Configuration
VIBELIFT_GE_ENGINES=agent-platform-demo
VIBELIFT_GE_LOCATION=global
VIBELIFT_GE_COLLECTION=default_collection
VIBELIFT_FLEET_TTL_SECONDS=60
VIBELIFT_FLEET_MIN_REFRESH_SECONDS=10
VIBELIFT_MONITORED_SERVICES=
# Public base URL for the A2A agent card and the ADK open_dashboard link. Leave empty locally: the card
# then uses the request's host. deploy_cloud_run.sh sets https://SERVICE-PROJECT_NUMBER.REGION.run.app.
VIBELIFT_PUBLIC_URL=

# Gemini Enterprise reporting mart (created by deploy/bigquery/provision_ge_mart.py; see docs/GE_MART.md)
VIBELIFT_GE_CURATED_DATASET=ds_ge_curated_staging
VIBELIFT_GE_MART_DATASET=vibelift_mart
# Cloud Billing export table (project.dataset.gcp_billing_export_v1_XXXX). Empty = cost shown as unknown.
VIBELIFT_BILLING_EXPORT_TABLE=

# Gemini Enterprise BYO MCP App Configuration
ENABLE_MCP_APP=1
MCP_PROTOCOL_VERSION=2025-06-18
